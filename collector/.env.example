# Kopieren nach .env und ausfüllen. Die .env NIE ins Repo hochladen.

# --- FENECON (FEMS, App "Modbus/TCP lesend") ---
FENECON_HOST=192.168.188.59
FENECON_PORT=502
FENECON_UNIT_ID=1
# 3 = Holding Register, 4 = Input Register (npm run test:fenecon zeigt, was geht)
FENECON_FUNCTION_CODE=3

# --- Loxone Miniserver ---
LOXONE_HOST=192.168.188.128
# Empfehlung: eigener Benutzer "api" mit Rechten nur auf die benötigten Bausteine
LOXONE_USER=api
LOXONE_PASSWORD=

# --- Supabase (neues Projekt "Heizung München") ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role-Key: Supabase → Project Settings → API. Bleibt nur auf dem Mini-PC!
SUPABASE_SERVICE_ROLE_KEY=

# --- Betrieb ---
INTERVAL_SECONDS=60
RETENTION_DAYS=90
# 1 = niemals nach Loxone schreiben, egal was in der App eingestellt ist
FORCE_DRY_RUN=0

# --- nur für npm run test:loxone ---
TEST_TEMP_NAME=Temp KG Bad
TEST_SETPOINT_NAME=API_Boost_Bad
TEST_VALVE_NAME=Bad KG
